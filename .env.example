# LLM Provider Configuration (openrouter | aiml | mock)
LLM_PROVIDER=openrouter
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct:free

# AIML API Configuration (Fallback)
AIML_API_KEY=your_aiml_api_key_here
AIML_MODEL=meta-llama/Llama-3.3-70B-Instruct-Turbo

# Agent Feature Flag (Enables ReAct tool-calling agent for chat)
AGENT_QA_ENABLED=false

# GitHub Configuration (Optional)
GITHUB_TOKEN=your_github_token_here

# Flask Configuration
FLASK_ENV=development
FLASK_DEBUG=True
SECRET_KEY=your_secret_key_here

# Application Configuration
MAX_REPO_SIZE_MB=500
MAX_ANALYZED_FILES=500
ANALYSIS_TIMEOUT_SECONDS=300
CACHE_ENABLED=True